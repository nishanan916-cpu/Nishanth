# Rename this file to ".env" and fill in your real values.

# Get a free key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Which Gemini model to use. "gemini-1.5-flash" is fast & cheap.
# If that model is ever retired, try "gemini-2.0-flash" instead.
GEMINI_MODEL=gemini-1.5-flash

# Secret key used to sign JWT auth tokens. Change this to any random string.
SECRET_KEY=change-this-to-a-long-random-secret-string

# Exchange rate used to convert USD budgets typed by users into INR
USD_TO_INR_RATE=83.0
